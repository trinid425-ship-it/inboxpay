# Copy this file to .env and fill it in. Never commit .env.

# PayPal REST app credentials from https://developer.paypal.com (Apps & Credentials).
# Use the Sandbox toggle for testing; no real money moves.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI: set ONE of these. Gemini is used when both are set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
